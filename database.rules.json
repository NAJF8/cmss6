      "$uid": {
        "isSuperAdmin": {
          ".validate": "newData.val() === true ? (root.child('users/' + auth.uid + '/isSuperAdmin').val() === true || auth.token.email === 'mohameadalhaear100@gmail.com') : true"
        }
      }
    },
    "roles": {
      ".read": "auth != null",
